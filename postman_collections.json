            },
            "url": {
              "raw": "{{baseUrl}}/admin/exam-periods/{{examPeriodId}}/imports/course-enrollments",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "exam-periods", "{{examPeriodId}}", "imports", "course-enrollments"]
